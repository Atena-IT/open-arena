# What a run reads from the environment. Copy this file to `.env` and fill in
# only what your models and datasets need:
#
#   cp .env.template .env
#
# `openarena evaluations run` loads `.env` from the workspace (beside configs/)
# and never overrides a variable already set in your shell; no other command
# reads it. Keep `.env` out of git (the workspace's .gitignore already does).

# --- Hosted models -------------------------------------------------------------
# A model's `model:` prefix in models.yaml picks the provider; set the key of
# each provider you use. Any other provider litellm supports reads its own
# variable the same way.

# `openai/...` ids, e.g. openai/gpt-4o-mini.
# OPENAI_API_KEY=
# `anthropic/...` ids, e.g. anthropic/claude-sonnet-4-5.
# ANTHROPIC_API_KEY=
# `gemini/...` ids (Google AI Studio), e.g. gemini/gemini-2.5-flash.
# GEMINI_API_KEY=
# `mistral/...` ids, e.g. mistral/mistral-small-latest.
# MISTRAL_API_KEY=
# `groq/...` ids, e.g. groq/llama-3.3-70b-versatile.
# GROQ_API_KEY=
# `openrouter/...` ids: one key for many providers' models.
# OPENROUTER_API_KEY=
# `typesafe/...` decision models (`type: decision`), e.g. typesafe/jev-latest.
# TYPESAFE_API_KEY=

# --- Local models --------------------------------------------------------------
# No key and no bill; their cost shows as 0.

# `ollama/...` ids. Only needed when Ollama is not on its default address.
# OLLAMA_API_BASE=http://localhost:11434
# `vllm/...` ids: your vLLM server's OpenAI-compatible endpoint. Required for
# vllm ids, and the /v1 suffix is required.
# HOSTED_VLLM_API_BASE=http://localhost:8000/v1

# --- Dataset sources -----------------------------------------------------------
# Only for the `type:` your datasets.yaml uses. Local files, folders and
# Hugging Face public datasets need nothing here.

# `langfuse` datasets: the project's keys and the server (cloud or self-hosted).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# `langsmith` datasets. The endpoint only for a self-hosted or EU instance.
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=
# `phoenix` datasets: the server, and its key when it requires one.
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_API_KEY=
# `opik` datasets: the key and workspace for Comet's cloud, or the URL of a
# self-hosted Opik.
# OPIK_API_KEY=
# OPIK_WORKSPACE=
# OPIK_URL_OVERRIDE=
# `braintrust` datasets. The app URL and org only for a self-hosted or
# multi-org account.
# BRAINTRUST_API_KEY=
# BRAINTRUST_APP_URL=
# BRAINTRUST_ORG_NAME=
# `mlflow` datasets: the server the datasets live on, when it is not the
# tracing server below (a dataset's own `tracking_uri:` beats both).
# MLFLOW_SOURCE_TRACKING_URI=http://localhost:5000
# `unity_catalog` datasets: the catalog's REST API and token (both required),
# and the object-store credentials its tables are read with.
# UNITY_CATALOG_API_URL=
# UC_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# S3_ENDPOINT=                        # only for S3-compatible storage (MinIO, ...)

# --- Harbor datasets (task folders, environments) ------------------------------
# Where trials run. E2B by default; without E2B_API_KEY it falls back to this
# machine's Docker. Name another provider Harbor supports to use it instead.
# ARENA_HARBOR_SANDBOX=e2b            # or docker, daytona, modal, ...
# That provider's own settings, a JSON object Harbor hands its environment:
# ARENA_HARBOR_SANDBOX_OPTIONS={"namespace": "sandboxes"}
# E2B_API_KEY=
# Local Docker only, for what an environment entry leaves blank: CPUs (at most
# this machine's), memory in MB, and how many trials run at once.
# ARENA_HARBOR_LOCAL_CPUS=2
# ARENA_HARBOR_LOCAL_MEMORY_MB=2048
# ARENA_HARBOR_LOCAL_TRIALS=1
# Where task folders are copied and trials write their logs (default: the
# run's state, .open-arena/<evaluation>/harbor/; ~/arena-harbor/ when Docker
# is installed as a snap and cannot read a hidden folder).
# ARENA_HARBOR_WORKDIR=

# --- Tracing (optional) --------------------------------------------------------
# Read by the arena app and by run_sweep called from Python: they trace into
# MLflow when MLFLOW_TRACKING_URI is set. `openarena evaluations run` does not
# trace; its record is .open-arena/<evaluation>/result.json.
# MLFLOW_TRACKING_URI=http://localhost:5000
# The experiment traces go to when a run names none.
# MLFLOW_EXPERIMENT_NAME=
# 0, false, no or off turns tracing off while keeping the URI.
# ARENA_MLFLOW_TRACING=0
