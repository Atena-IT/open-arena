# What a run reads from the environment. Copy this file to `.env` and fill in
# only what your models and datasets need; `openarena` loads `.env` from the
# workspace (beside configs/) and never overrides a variable already set.
#
#   cp .env.template .env

# --- Hosted models (litellm-style; the one matching each `models.yaml` id) ----
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- Local models -------------------------------------------------------------
# `ollama/...` ids reach a local Ollama:
# OLLAMA_API_BASE=http://localhost:11434
# `vllm/...` ids need your vLLM server's OpenAI endpoint (the /v1 suffix is required):
# HOSTED_VLLM_API_BASE=http://localhost:8000/v1

# --- Harbor datasets (task folders, environments) -------------------------------
# Trials run on E2B with a key, else on this machine's Docker.
# E2B_API_KEY=
# ARENA_HARBOR_SANDBOX=e2b            # or docker, daytona, modal, ...

# --- Tracing (optional) ---------------------------------------------------------
# Read by the arena app and by run_sweep called from Python: they trace into
# MLflow when this is set. `openarena evaluations run` does not trace; its
# record is .open-arena/<evaluation>/result.json.
# MLFLOW_TRACKING_URI=http://localhost:5000
# ARENA_MLFLOW_TRACING=0              # opt out while keeping the URI
