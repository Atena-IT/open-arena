# ============================================================================
# Open Arena — environment variable contract
# Copy this file to `.env` and fill in only the variables you actually use.
# NEVER commit a real `.env`; this template is safe for version control.
#
# Variable groupings follow the deploy/README.md contract.
# ============================================================================

# ----------------------------------------------------------------------------
# API authentication
# Bearer token required on all API requests: Authorization: Bearer <token>
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------------------------------------------------------
OPEN_ARENA_API_TOKEN=change-me-before-production

# ----------------------------------------------------------------------------
# Database
# Forward-looking for WS1 (Postgres adapter). Defaults to SQLite at
# .open-arena/api.db when unset. The docker-compose.yml injects the Postgres
# DSN automatically for the compose stack; override here for other targets.
# ----------------------------------------------------------------------------
DATABASE_URL=

# docker-compose only: Postgres superuser password (used in DATABASE_URL above)
POSTGRES_PASSWORD=arena_dev

# ----------------------------------------------------------------------------
# Gitea source-control integration
# ----------------------------------------------------------------------------
GITEA_BASE_URL=https://gitea.example.com
GITEA_TOKEN=
GITEA_ORG=

# ----------------------------------------------------------------------------
# Databricks Unity Catalog
# ----------------------------------------------------------------------------
UNITY_CATALOG_API_URL=https://your-workspace.azuredatabricks.net/api/2.1/unity-catalog
UC_TOKEN=

# ----------------------------------------------------------------------------
# MLflow experiment tracking
# ----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TRACKING_TOKEN=

# ----------------------------------------------------------------------------
# S3 / object storage (MinIO, Scaleway, AWS, …)
# AWS_DEFAULT_REGION defaults to fr-par (Scaleway Paris).
# ----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=open-arena
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=fr-par

# ----------------------------------------------------------------------------
# OIDC / SSO
# ----------------------------------------------------------------------------
OIDC_ISSUER=https://your-idp.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# E2B code-execution sandbox
# ----------------------------------------------------------------------------
E2B_API_KEY=
# Sandbox provider: "local" (default, no isolation) or "e2b"
OPEN_ARENA_SANDBOX=local

# ----------------------------------------------------------------------------
# LM / embedding providers (passed through to litellm)
# Only fill in the providers you actually use.
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
TOGETHER_AI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Azure OpenAI
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# AWS Bedrock (shares AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY above)
AWS_REGION_NAME=us-east-1

# Self-hosted
OLLAMA_API_BASE=
HOSTED_VLLM_API_BASE=

# HuggingFace Hub (gated models / private datasets)
HF_TOKEN=

# ----------------------------------------------------------------------------
# Dataset providers
# ----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=

OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_URL_OVERRIDE=

PHOENIX_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=

BRAINTRUST_API_KEY=
BRAINTRUST_APP_URL=
BRAINTRUST_ORG_NAME=
